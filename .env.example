# --- GitHub data store (private repo, branch "data") ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=gkds
GITHUB_BRANCH=data

# --- Admin ---
# Default access code. Replace it in Vercel env vars, then change it from the admin Security page.
ADMIN_CODE=gkds1993
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=
# Set to 1 only to recover a forgotten access code (see docs), then remove it.
ADMIN_CODE_RESET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=
REVALIDATE_SECRET=

# --- Optional commit author for admin edits ---
GIT_COMMIT_NAME=
GIT_COMMIT_EMAIL=
