# =====================================================================
#  Gopal Krushna Driving Training School — environment variables
#  Local: copy to .env.local   |   Live: add the same names in Vercel
#  (Project > Settings > Environment Variables). Never commit real values.
#  The public website works with NONE of these set (it uses the bundled content).
# =====================================================================

# ---------------------------------------------------------------------
# 1. GitHub data store  (needed for: admin edits, posting reviews, photos)
#    Content lives in the private repo, branch "data".
# ---------------------------------------------------------------------
# Fine-grained personal access token: GitHub > Settings > Developer settings >
# Personal access tokens > Fine-grained. Repo access: only the gkds repo.
# Permission: Contents = Read and write.
GITHUB_TOKEN=
# Your GitHub username (or organisation) that owns the repo.
GITHUB_OWNER=
# Repository name.
GITHUB_REPO=gkds
# Branch that holds the content. Keep as "data" (Vercel must not build it).
GITHUB_BRANCH=data

# ---------------------------------------------------------------------
# 2. Admin panel  (/admin and /malika)
# ---------------------------------------------------------------------
# First-time access code. Change it here, then change it again from the
# admin "Security" page (the saved, hashed code takes over after that).
ADMIN_CODE=gkds1993
# Secret that signs the admin login cookie. REQUIRED on Vercel (login is
# disabled without it). Generate a new one with:  openssl rand -base64 32
ADMIN_JWT_SECRET=
# Set to 1 ONLY if you forgot the access code: it makes ADMIN_CODE work again.
# Remove it (leave empty) afterwards.
ADMIN_CODE_RESET=

# ---------------------------------------------------------------------
# 3. Website
# ---------------------------------------------------------------------
# Public address of the live site, no trailing slash. Used for the sitemap,
# share images and Google data. Example: https://www.gopalkrushnadriving.in
# (leave empty locally)
NEXT_PUBLIC_SITE_URL=
# Secret for manually refreshing cached content: POST /api/revalidate with the
# header  x-revalidate-secret: <this value>
REVALIDATE_SECRET=

# ---------------------------------------------------------------------
# 4. Optional: author shown on the GitHub commits made by the admin panel
# ---------------------------------------------------------------------
GIT_COMMIT_NAME=GKDS Admin
GIT_COMMIT_EMAIL=
